# 复制为 .env 并填写真实凭据（.env 不提交到 git）
# QQ 邮箱 SMTP：smtp.qq.com:587，需开启 SMTP 服务并获取授权码

# SMTP 配置
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your_account@qq.com
SMTP_PASS=your_smtp_auth_code

# GitHub Token（用于拉取组织仓库与协作者；需 repo 权限）
GITHUB_TOKEN=your_github_token

# 定时参数（可选，默认工作日 09:00）
RUN_HOUR=9
RUN_MINUTE=0
POLL_SECONDS=30
